{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "TRACE",
	"version": "0.6.1",
	"identifier": "run.simtrace.trace",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{ "label": "main", "title": "TRACE — FIND THE TIME", "width": 1600, "height": 1000, "minWidth": 1440, "minHeight": 900, "decorations": false }
		],
		"security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
	},
	"bundle": { "active": true, "targets": "all", "createUpdaterArtifacts": true },
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyN0Y2MkRFRDI4RUFBMTMKUldRVHFvN1MzbUovY2hhWjRtaFlaakZOczk2ZGY1aFVORWswRk9JZHZPc0J5QnpBMmVtTHNEQVMK",
			"endpoints": ["https://github.com/keystroke-tools/TRACE/releases/latest/download/latest.json"],
			"windows": { "installMode": "passive" }
		}
	}
}
