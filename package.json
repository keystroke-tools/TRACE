{
	"name": "trace-workspace",
	"private": true,
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"build": "pnpm --filter @trace/desktop --filter @trace/web build",
		"check": "pnpm format:check && pnpm --filter @trace/desktop --filter @trace/web check",
		"format": "prettier --write \"apps/**/*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,css,html,yaml,yml,md}\" package.json pnpm-workspace.yaml",
		"format:check": "prettier --check \"apps/**/*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,css,html,yaml,yml,md}\" package.json pnpm-workspace.yaml"
	},
	"devDependencies": {
		"prettier": "^3.9.6"
	}
}
